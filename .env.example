# ── 每台 Raspberry Pi 的專屬設定 ──────────────────────────────
#
# 用法：clone 之後複製一份成 .env，再依這台 Pi 的情況修改
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d
#
# .env 不會進版控（見 .gitignore），所以每台 Pi 可以有自己的值，
# 而 docker-compose.yml 保持完全相同，git pull 不會衝突。


# 這台 Pi 的識別碼。多台 Pi 務必各自不同，
# 且要跟 PC 端控制中心新增裝置時填的「Device ID」一致（例如 pi-01）。
# 健康監控（Beszel）也用它當這台 Pi 的名稱來對應。
PI_ID=pi-01


# 這台 Pi 接的 Arduino 是哪一種板子：mega 或 uno。
# 決定網頁顯示哪些軸的按鈕（指令表見 commands.py）。填錯值服務會拒絕啟動。
BOARD=mega


# Arduino 接在哪個序列埠。容器掛的是整個 /dev，所以沒接 Arduino 也能啟動，
# 插上後下一次請求就會自動連上。
#
# 怎麼查：在 Pi 上執行 ls -l /dev/serial/by-id/
#   建議直接填 by-id 的完整路徑（例如 /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0），
#   拔插或多接一個 USB 裝置時不會變號。
#   或填 tty 名稱：
#     正版 Uno / Mega（16U2 晶片）  通常是 /dev/ttyACM0
#     CH340 晶片的副廠板            通常是 /dev/ttyUSB0
SERIAL_PORT=/dev/ttyUSB0


# 序列埠鮑率，必須跟 Arduino 韌體 Serial.begin() 裡的數字一致
BAUD_RATE=115200


# 這台 Pi 對外開放的連接埠（PC 端就是連這個埠）。
# 除非 5000 被佔用，否則不用改。
HOST_PORT=5000


# 單一指令最長容許耗時（秒）。天車韌體有些指令(校正、歸位)是阻塞的，
# 真機低速模式走完整個行程單趟可能超過 30 秒，逾時設太短會誤判成斷線。
# 個別 /api/command 請求仍可用 "timeout" 欄位覆蓋這個預設值。
# PC 控制中心會從 /api/status 讀到這個值，不需要在 PC 端另外設定。
COMMAND_TIMEOUT=130

# 單一請求可以指定的 timeout 上限（秒）
MAX_COMMAND_TIMEOUT=300


# 選填。用預先建好的 image（CI 推到 GHCR）而不是在 Pi 上 build：
#   PI_IMAGE=ghcr.io/frank931023/pi-arduino-connection-test-0717:main
#   然後 docker compose pull && docker compose up -d
# PI_IMAGE=


# ── 選用：Pi 健康監控（Beszel agent）──────────────────────────
# 不需要的話整段留著註解即可。要啟用：打開 PC 控制中心網頁左側的 ⚙（Monitoring setup），
# 把它給的四行貼在這裡取代下面的範例，然後 docker compose up -d。
#
# COMPOSE_PROFILES=monitoring
# BESZEL_HUB_URL=http://<PC 的 IP>:8090
# BESZEL_KEY="ssh-ed25519 AAAA..."
# BESZEL_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
